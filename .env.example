# Copy to .env.local and fill in. These keys are server-only: never add NEXT_PUBLIC_.
PARALLEL_API_KEY=
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Required in production: salts the email hash behind the daily research limit. Without it,
# creating or refreshing a dossier fails. Any long random string, e.g. `openssl rand -hex 32`.
EMAIL_HASH_SALT=

# Verifies Parallel webhook signatures (whsec_…).
PARALLEL_WEBHOOK_SECRET=

# mock replays scripts/spike/out and calls no paid API; live spends money (confirm first).
RESEARCH_MODE=mock

# Webhook callback base and the links we display, e.g. https://portolan.example
APP_BASE_URL=http://localhost:3000

# Stays false until a lawyer signs off on the team network for real dossiers.
TEAM_NETWORK_REAL_ENABLED=false

# Shown as the expected finish for expert review.
EXPERT_REVIEW_ETA_TEXT="within 4 weeks"

# Optional. Slack incoming-webhook URL for waitlist sign-up messages; unset = no message.
WAITLIST_SLACK_WEBHOOK_URL=

# The PostHog project key is public by design and appears in the browser.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
